    table.insert(Session.Connections, RunService.Heartbeat:Connect(function()
        if #S.LogQueue == 0 then return end
        local lines = {}
        while #S.LogQueue > 0 do
            local item = table.remove(S.LogQueue, 1)
            table.insert(S.SessionLogs, item[2])
            table.insert(lines, item[1])
        end
        RecordConsole:Append(table.concat(lines, "\n"))
        updateRecordStats()
    end))

    local function safeAddLog(text, code)
        if not S.IsRecording then return end
        table.insert(S.LogQueue, {text, code})
    end

    table.insert(Session.Connections, autoSkipObj.Changed:Connect(function(val)
        if val ~= S.LastLoggedAutoSkip then
            S.LastLoggedAutoSkip = val
            local cmd = val and "EnableAutoSkip()" or "DisableAutoSkip()"
            if S.IsAutoQueue then autoTickLog(cmd) end
            safeAddLog(val and "🔁 AutoSkip: ON" or "🔁 AutoSkip: OFF", cmd)
        end
    end))

    genv.UTH_RemoteHandler = function(remoteName, args)
        if not Session.Alive then return end

        if remoteName == "ResultEvent" and args[1] == "Retry" then
            if AutoResetToggle.value then clearAllData() end

        elseif remoteName == "TroopPlace" and typeof(args[2]) == "Vector3" then
            local rawName = args[1].Name
            local pos = args[2]
            local unitID = args[3]
            local cleanName = rawName:gsub(" Point", "")

            S.UnitIDToHero[unitID] = cleanName
            S.TroopCounts[cleanName] = (S.TroopCounts[cleanName] or 0) + 1
            local idx = S.TroopCounts[cleanName]
            local exactCmd = string.format('QueuePlace("%s", %.4f, %.4f, %.4f)', cleanName, pos.X, pos.Y, pos.Z)

            if S.IsAutoQueue then autoTickLog('QueuePlace("' .. cleanName .. '"') end
            safeAddLog("🟢 Place " .. cleanName, exactCmd)

            task.delay(0.5, function()
                for _, v in ipairs(TroopFolder:GetChildren()) do
                    if not S.TroopMapping[v] and (v:GetAttribute("UnitSeed") == unitID or (v:GetModelCFrame().Position - pos).Magnitude < 5) then
                        S.TroopMapping[v] = {name = cleanName, index = idx, level = 1, abilityCount = 0, id = unitID}
                        break
                    end
                end
            end)

        elseif remoteName == "UpdateTargeting" then
            local unit = args[1]
            local d = S.TroopMapping[unit]
            if d then
                local exactCmd = string.format('QueueTarget("%s", %d, "%s")', d.name, d.index, args[2])
                if S.IsAutoQueue then autoTickLog(exactCmd) end
                safeAddLog("🎯 Target " .. args[2], exactCmd)
            end

        elseif remoteName == "TroopEvent" then
            if S.IsResetting then return end

            local act, unitIdentifier = args[1], args[2]
            local d, actualUnit
            if typeof(unitIdentifier) == "number" then
                for unit, data in pairs(S.TroopMapping) do
                    if data.id == unitIdentifier then d = data; actualUnit = unit; break end
                end
            else
                d = S.TroopMapping[unitIdentifier]; actualUnit = unitIdentifier
            end

            if d then
                if act == "Upgrade" then
                    d.level = d.level + 1
                    local cmd = string.format('QueueUpgrade("%s", %d, %d)', d.name, d.index, d.level)
                    if S.IsAutoQueue then autoTickLog(cmd) end
                    safeAddLog(string.format("🔵 Upgrade %s %d", d.name, d.index), cmd)

                elseif act == "Ability" then
                    S.GlobalAbilityCounts[d.name] = (S.GlobalAbilityCounts[d.name] or 0) + 1
                    local cost = getAbilityCost(d.name, actualUnit)
                    d.abilityCount = d.abilityCount + 1
                    local manaCmd = string.format('QueueWaitMana(%d)', cost)
                    local abCmd = string.format('QueueAbility("%s", %d)', d.name, d.index)

                    if S.IsAutoQueue then autoTickLog(manaCmd); autoTickLog(abCmd) end
                    safeAddLog("🟡 Wait Mana: " .. cost, manaCmd)
                    safeAddLog("🟠 " .. d.name .. " Ability", abCmd)

                elseif act == "Sell" then
                    local cmd = string.format('QueueSell("%s", %d)', d.name, d.index)
                    if S.IsAutoQueue then autoTickLog(cmd) end
                    safeAddLog("🔴 Sell " .. d.name, cmd)

                    if typeof(unitIdentifier) == "Instance" then
                        S.TroopMapping[unitIdentifier] = nil
                    else
                        for k, v in pairs(S.TroopMapping) do if v.id == unitIdentifier then S.TroopMapping[k] = nil break end end
                    end

                elseif act == "BulkSell" then
                    local heroType = args[3]
                    local cmd = string.format('QueueBulkSell("%s")', heroType)
                    if S.IsAutoQueue then autoTickLog(cmd) end
                    safeAddLog("🟥 Bulk Sell " .. heroType, cmd)
                    for unit, data in pairs(S.TroopMapping) do if data.name == heroType then S.TroopMapping[unit] = nil end end

                elseif act == "BulkUp" then
                    local bn = args[3] or "Unknown"
                    local cost = 0
                    local dataRef = findUnitData(bn)
                    local stg = dataRef and (dataRef.Stages or dataRef.Levels or dataRef.Upgrades)

                    for unit, dInfo in pairs(S.TroopMapping) do
                        if dInfo.name == bn then
                            local nl = dInfo.level + 1
                            if stg and stg[nl] then
                                local raw = stg[nl].Cost or stg[nl].Price
                                local stats = unit:FindFirstChild("Stats")
                                if stats then cost = cost + (tonumber(getFinalCost(raw, stats, false)) or 0) end
                            end
                            dInfo.level = nl
                        end
                    end
                    local cmd = string.format('QueueBulk("%s")', bn)
                    if S.IsAutoQueue then
                        if cost > 0 then autoTickLog(string.format('QueueWaitMana(%d)', cost)) end
                        autoTickLog(cmd)
                    end
                    if cost > 0 then safeAddLog("🟡 Wait Mana: " .. cost, string.format('QueueWaitMana(%d)', cost)) end
                    safeAddLog("🟣 Bulk " .. bn, cmd)
                end
            end

        elseif remoteName == "SkipWave" then
            if autoSkipObj.Value == false then
                if S.IsAutoQueue then autoTickLog("QueueSkip()") end
                safeAddLog("⏩ Manual Skip", "QueueSkip()")
            end

        elseif remoteName == "ModeVote" then
            local cmd = string.format('VoteMode("%s")', tostring(args[1]))
            if S.IsAutoQueue then autoTickLog(cmd) end
            safeAddLog("🗳️ Vote: " .. tostring(args[1]), cmd)
        end
    end

    if not genv.UTH_HookInstalled then
        genv.UTH_HookInstalled = true
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local handler = genv.UTH_RemoteHandler
                if handler then
                    local args = {...}
                    local remoteName = tostring(self)
                    task.spawn(function() pcall(handler, remoteName, args) end)
                end
            end
            return oldNamecall(self, ...)
        end)
    end

    refreshFiles()
    updateRecordStats()
end

