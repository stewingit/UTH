local function CreateRadioRow(parent, flagPrefix, items, default, onChange)
    local row = parent:CreateGroup({direction = "row"})
    local toggles = {}

    local function current()
        for _, item in ipairs(items) do
            if toggles[item.value] and toggles[item.value].value then return item.value end
        end
        return default
    end

    local function select(value)
        for _, item in ipairs(items) do
            local t = toggles[item.value]
            local want = (item.value == value)
            if t and t.value ~= want then t:Set(want, true) end
        end
        if onChange then onChange(value) end
    end

    for _, item in ipairs(items) do
        toggles[item.value] = row:CreateToggle({
            name = item.label,
            flag = flagPrefix .. item.label,
            value = (item.value == default),
            callback = function(on)
                if on then
                    select(item.value)
                else

                    local anyOn = false
                    for v, t in pairs(toggles) do if v ~= item.value and t.value then anyOn = true end end
                    if not anyOn then toggles[item.value]:Set(true, true) end
                end
            end,
        })
    end
    return {Get = current, Set = select}
end

