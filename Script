    local function refreshStatsUI()
        local troops = TroopFolder:GetChildren()
        local sTime = Workspace:GetServerTimeNow()
        local groups, groupOrder = {}, {}
        local readyCount = 0

        for i, unit in ipairs(troops) do
            local stats = unit:FindFirstChild("Stats")
            if stats then
                local unitModule = toStr(stats:FindFirstChild("Module") or unit)
                local level = stats:FindFirstChild("Level") and stats.Level.Value or 1
                local targetType = toStr(stats:FindFirstChild("TargetType") or "N/A")
                local spawner = stats:FindFirstChild("Spawner")
                local isDrawing = (spawner and spawner.Value) or (unitModule == "Drawing")
                local status, cooldownText = "MAX", ""

                if isDrawing then
                    local hpVal = stats:FindFirstChild("Health")
                    local currentHP = hpVal and hpVal.Value or 0
                    local maxHP = (hpVal and hpVal:FindFirstChild("BaseHealth")) and hpVal.BaseHealth.Value or 1
                    local ownerLevel = 1
                    if spawner and spawner.Value then
                        local ownerStats = spawner.Value:FindFirstChild("Stats")
                        if ownerStats and ownerStats:FindFirstChild("Level") then ownerLevel = ownerStats.Level.Value end
                    end
                    local config = STELLA_SETTINGS[ownerLevel] or STELLA_SETTINGS[5]
                    local missingHP = math.max(0, maxHP - currentHP)
                    local abilityPrice = math.floor(config.Base + (missingHP * config.Penalty))
                    status = string.format("HP: %d/%d | Cost: %d (Stella Lvl %d)", currentHP, maxHP, abilityPrice, ownerLevel)
                    targetType = "N/A"
                else
                    local data = findUnitData(unitModule)
                    if data then
                        local stg = data.Stages or data.Levels or data.Upgrades
                        local cur, nxt = stg[level], stg[level + 1]
                        if cur and cur.SpecialAbility then
                            local sa = cur.SpecialAbility
                            local cost = getFinalCost(sa.Cost or sa.Price, stats, true)
                            status = ("%s [%s]"):format(sa.Title or "Ability", cost or "Active")
                            local aTick = stats:FindFirstChild("AbilityTick")
                            if aTick then
                                local cd = sa.Cooldown or sa.CD or sa.Duration or 0
                                local remaining = math.max(0, (aTick.Value + cd) - sTime)
                                if remaining > 0 then
                                    local remRounded = math.floor(remaining * 2) / 2
                                    cooldownText = ("\n   > ⏳ (%.1fs / %ds)"):format(remRounded, cd)
                                else
                                    cooldownText = ("\n   > ✅ (READY / %ds)"):format(cd)
                                    readyCount += 1
                                end
                            end
                        elseif nxt then
                            status = ("Upgrade [%s]"):format(getFinalCost(nxt.Cost or nxt.Price, stats, false) or "???")
                        end
                    end
                end

                local exactKey = string.format("%s_%s_%s_%s_%s", unitModule, level, status, cooldownText, targetType)
                if not groups[exactKey] then
                    groups[exactKey] = {indices = {}, unitModule = unitModule, level = level, status = status, cooldownText = cooldownText, targetType = targetType}
                    table.insert(groupOrder, exactKey)
                end
                table.insert(groups[exactKey].indices, i)
            end
        end

        local blocks = {}
        for _, key in ipairs(groupOrder) do
            local g = groups[key]
            table.insert(blocks, ("[%s] %s (Lvl %s)\nStatus: %s%s\nTarget: %s"):format(
                table.concat(g.indices, ","), g.unitModule, tostring(g.level), g.status, g.cooldownText, g.targetType))
        end
        local text = #blocks > 0 and table.concat(blocks, "\n\n") or "No heroes placed."

        PlacedStat:Set(#troops)
        ReadyStat:Set(readyCount)
        if text ~= lastHeroText then
            lastHeroText = text
            HeroConsole:Set(text)
        end
    end

    task.spawn(function()
        while Session.Alive do
            if not Window.hidden then pcall(refreshStatsUI) end
            task.wait(0.5)
        end
    end)

    RunTab:CreateSection({name = "Loaded Strategy"})
    local LoadedText = RunTab:CreateText({name = "Nothing loaded", text = "Load a strategy from the Library tab."})
    local RunProgress = RunTab:CreateProgress({name = "Execution Progress", range = {0, 1}, value = 0, text = "Idle"})
    local runRow = RunTab:CreateGroup({direction = "row"})
    RunTab:CreateSection({name = "Execution Steps"})
    local StepConsole = RunTab:CreateConsole({name = "Steps", height = 300, maxLines = 1000, text = ""})

    local function redrawSteps()
        local lines, done = {}, 0
        for _, d in ipairs(S.LoadedLogsRef) do
            if d.Ticked then done += 1 end
            table.insert(lines, (d.Ticked and "✅ " or "⬜ ") .. d.Text)
        end
        StepConsole:Set(table.concat(lines, "\n"))
        local total = #S.LoadedLogsRef
        RunProgress:SetRange(0, math.max(total, 1))
        RunProgress:Set(done)
        if total == 0 then
            RunProgress:SetText("Idle")
        elseif done >= total then
            RunProgress:SetText("Complete (" .. done .. "/" .. total .. ")")
        elseif S.IsAutoQueue then
            RunProgress:SetText(("Running  %d/%d"):format(done, total))
        else
            RunProgress:SetText(("Ready  %d steps"):format(total))
        end
    end

    local function autoTickLog(actionCode)
        for _, data in ipairs(S.LoadedLogsRef) do
            if not data.Ticked and data.Code:find(actionCode, 1, true) then
                data.Ticked = true
                redrawSteps()
                break
            end
        end
    end

    local function getEmojiPrefix(line)
        if line:find('QueuePlace') then return "🟢 Place"
        elseif line:find('QueueUpgrade') then return "🔵 Upgrade"
        elseif line:find('QueueSell') then return "🔴 Sell"
        elseif line:find('QueueBulkSell') then return "🟥 Bulk Sell"
        elseif line:find('QueueAbility') then return "🟠 Ability"
        elseif line:find('QueueTarget') then return "🎯 Target"
        elseif line:find('QueueWaitMana') then return "🟡 Wait Mana"
        elseif line:find('QueueSkip') then return "⏩ Manual Skip"
        elseif line:find('EnableAutoSkip') then return "🔁 AutoSkip: ON"
        elseif line:find('DisableAutoSkip') then return "🔁 AutoSkip: OFF"
        elseif line:find('VoteMode') then return "🗳️ Vote"
        elseif line:find('QueueBulk') then return "🟣 Bulk"
        else return "⚙️ Action" end
    end

    local function parseScript(content, name)
        S.LoadedLogsRef = {}
        local body = {}
        for line in content:gmatch("[^\r\n]+") do
            if not line:find("loadstring") and not line:find("StartAutomation") and line:match("%S") then
                local prefix = getEmojiPrefix(line)
                local detail = line:match('"(.-)"') or line:match('%((%d+)%)') or ""
                if line:find('QueuePlace') then detail = line:match('QueuePlace%(\"(.-)\"') or "" end
                table.insert(S.LoadedLogsRef, {
                    Code = line, Text = detail ~= "" and (prefix .. " " .. detail) or prefix, Ticked = false,
                })
                table.insert(body, line)
            end
        end
        S.LoadedBody = table.concat(body, "\n")
        S.LoadedName = name or "Strategy"
        S.IsAutoQueue = false
        LoadedText:SetTitle("Loaded: " .. S.LoadedName)
        LoadedText:Set(#S.LoadedLogsRef .. " steps ready to run.")
        redrawSteps()
    end

    local function startExecution()
        if S.LoadedBody == "" then
            return notify("Nothing Loaded", "Load a strategy from the Library tab first.", "circle-alert", 3)
        end
        S.IsAutoQueue = true
        redrawSteps()
        notify("Executed", "Strategy started.", "play", 3)
        local scriptToRun = 'loadstring(game:HttpGet("' .. CONFIG.ENGINE_LINK .. '"))()\n' .. S.LoadedBody .. '\nStartAutomation()'
        local f, err = loadstring(scriptToRun)
        if f then
            task.spawn(f)
        else
            S.IsAutoQueue = false
            redrawSteps()
            notify("Script Error", tostring(err), "circle-alert", 5)
        end
    end

    runRow:CreateButton({name = "Start Execution", icon = "play", callback = startExecution})
    runRow:CreateButton({
        name = "Copy Script", icon = "clipboard",
