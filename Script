    local STELLA_SETTINGS = {
        [1] = {Base = 20,  Penalty = 1},   [2] = {Base = 57,  Penalty = 3},
        [3] = {Base = 102, Penalty = 3.5}, [4] = {Base = 169, Penalty = 5},
