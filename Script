    local function buildSavedScript()
        return 'loadstring(game:HttpGet("' .. CONFIG.ENGINE_LINK .. '"))()\n\n' .. table.concat(S.SessionLogs, "\n") .. '\n\nStartAutomation()'
    end

    local function clearAllData()
        S.IsResetting = true
        for t, _ in pairs(S.TroopMapping) do
            if t and t.Parent then task.spawn(function() TroopEvent:FireServer("Sell", t) end) end
        end

        S.SessionLogs = {}; S.TroopCounts = {}; S.TroopMapping = {}; S.GlobalAbilityCounts = {}
        S.UnitIDToHero = {}; S.LogQueue = {}
        S.IsAutoQueue = false; S.IsRecording = false; S.StrategyName = ""
        S.LoadedLogsRef = {}; S.LoadedBody = ""; S.LoadedName = ""

        pcall(function() NameInput:Unlock() end)
        pcall(function() NameInput:Set("", true) end)
        StatusText:Set("Not recording.")
        RecordConsole:Clear()
        updateRecordStats()
        LoadedText:SetTitle("Nothing loaded")
        LoadedText:Set("Load a strategy from the Library tab.")
        redrawSteps()

        notify("Cleared", "Logs wiped and troops sold.", "trash", 3)
        task.delay(1, function() S.IsResetting = false end)
    end

    recRow1:CreateButton({
        name = "Begin Recording", icon = "video",
        callback = function()
            if S.IsRecording then return notify("Already Recording", "Logging: " .. S.StrategyName, "video", 2) end
            if S.StrategyName == "" then return notify("Error", "Please enter a name!", "circle-alert", 3) end
