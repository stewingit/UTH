local function BuildMatch()
    local S = {
        SessionLogs = {}, TroopCounts = {}, TroopMapping = {}, GlobalAbilityCounts = {}, UnitIDToHero = {},
        LoadedLogsRef = {}, LoadedBody = "", LoadedName = "",
        StrategyName = "",
        IsAutoQueue = false, IsRecording = false, IsResetting = false,
        LastLoggedAutoSkip = nil, LogQueue = {},
    }

    local info = pGui:WaitForChild("Menu", 10) and pGui.Menu:WaitForChild("Info", 10)
    local autoSkipObj = info and info:WaitForChild("AutoSkip", 10)
    local TroopFolder = Workspace:WaitForChild("Troop", 10)
    local Events = RS:WaitForChild("Events", 10)
    local TroopEvent = Events and Events:WaitForChild("TroopEvent", 10)
    if not (autoSkipObj and TroopFolder and TroopEvent) then
        notify("Match Setup Failed", "Couldn't find the match objects. Set CONFIG.CONTEXT = \"lobby\" if you're in the lobby.", "circle-alert", 6)
        return
    end

    if makefolder then pcall(makefolder, CONFIG.FOLDER) end

    local function toStr(val)
        return (typeof(val) == "Instance" and (val:IsA("ValueBase") and tostring(val.Value) or val.Name)) or tostring(val)
    end

    local function getFinalCost(raw, unitStats, isAbility)
        local base = typeof(raw) == "function" and (select(2, pcall(raw)) or 0) or tonumber(raw) or 0
        if base == 0 then return nil end
        local mult = 1
        if not isAbility then
            local bf = unitStats:FindFirstChild("BonusFolder")
            if bf then
                for _, buff in ipairs(bf:GetChildren()) do
                    local c = buff:FindFirstChild("Cost")
                    if c and c:IsA("ValueBase") then mult = mult * (tonumber(c.Value) or 1) end
                end
            end
        end
        return tostring(math.floor(base * mult))
    end

    local unitDataCache, unitDataMiss = {}, {}
    local function findUnitData(name)
        if unitDataCache[name] then return unitDataCache[name] end
        if unitDataMiss[name] and os.clock() - unitDataMiss[name] < 5 then return nil end
        local paths = {RS:FindFirstChild("Troops"), RS:FindFirstChild("Units"), RS}
        for _, p in ipairs(paths) do
            if not p then continue end
            local obj = (p.Name == name and p) or p:FindFirstChild(name, true)
            if obj and obj:IsA("ModuleScript") then
                local s, data = pcall(require, obj)
                if s and type(data) == "table" and (data.Stages or data.Levels or data.Upgrades) then
                    unitDataCache[name] = data
                    return data
                end
            end
        end
        unitDataMiss[name] = os.clock()
        return nil
    end

    local function getAbilityCost(heroName, unitInst)
        local data = findUnitData(heroName)
        local stats = unitInst and unitInst:FindFirstChild("Stats")
        if data and stats then
            local level = stats:FindFirstChild("Level") and stats.Level.Value or 1
            local stg = data.Stages or data.Levels or data.Upgrades
            local cur = stg[level]
            if cur and cur.SpecialAbility then
                local raw = cur.SpecialAbility.Cost or cur.SpecialAbility.Price
                return tonumber(getFinalCost(raw, stats, true)) or 0
            end
        end
        return 0
    end

    local function countMapping()
        local n = 0
        for _ in pairs(S.TroopMapping) do n += 1 end
        return n
    end

