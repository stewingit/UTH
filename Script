                    end
                end
            end

            starting = true
            pcall(function() StartBtn:Lock("Starting...") end)
            task.spawn(function()
                local total = 5 + (data and #data.Requirements or 0)
                local done = 0
                local function step(text)
                    done += 1
                    SetupProgress:Set(done)
                    SetupProgress:SetText(string.format("%s (%d/%d)", text, done, total))
                end
                SetupProgress:SetRange(0, total)
                SetupProgress:Set(0)
                SetupProgress:SetText("Preparing...")

                local ok, err = pcall(function()
                    if data then
                        for i, hero in ipairs(data.Requirements) do
                            equipEvent:InvokeServer(hero, i)
                            step("Equipped " .. hero)
                            task.wait(0.1)
                        end
                        if data.QueueScript and qot then qot(data.QueueScript) end
                    end

                    local icon = (mapName == "1Random") and GetRandomMapIcon() or VisualData[mapName]
                    notify("Starting Match", string.format("%s | %s | %s", mapName, mode, diffName), icon, 4)

                    event:FireServer("Create", true);                  step("Lobby created");   task.wait(0.2)
                    event:FireServer("Mode", mode);                    step("Mode set");        task.wait(0.2)
                    event:FireServer("Update", {Map = targetMap});     step("Map set");         task.wait(0.2)
                    event:FireServer("Difficulty", diffValue);         step("Difficulty set");  task.wait(0.2)
                    event:FireServer("Start");                         step("Started")
                end)

                if not ok then
                    SetupProgress:SetText("Failed")
                    notify("Start Failed", tostring(err), "circle-alert", 5)
                end
                task.wait(3)
                if Session.Alive then
                    SetupProgress:SetRange(0, 1)
                    SetupProgress:Set(0)
                    SetupProgress:SetText("Idle")
                    pcall(function() StartBtn:Unlock() end)
                end
                starting = false
            end)
        end,
