    local function refreshFiles()
        fileMap = {}
        if listfiles then
            local ok, files = pcall(listfiles, CONFIG.FOLDER)
            if ok and files then
                for _, file in ipairs(files) do
                    local clean = tostring(file):match("([^/\\]+)%.lua$")
                    if clean then fileMap[clean] = file end
                end
            end
        end
        local names = toList(fileMap)
        FileDD:Refresh(names)
        return #names
    end

