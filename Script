                setclipboard('loadstring(game:HttpGet("' .. CONFIG.ENGINE_LINK .. '"))()\n\n' .. S.LoadedBody .. '\n\nStartAutomation()')
                notify("Copied", "Strategy script copied to clipboard.", "clipboard", 2)
            end
        end,
    })

